[gd_resource type="Resource" script_class="Commission" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/commission/commission.gd" id="1_commission"]
[ext_resource type="Script" path="res://scripts/commission/commission_condition.gd" id="2_condition"]
[ext_resource type="Script" path="res://scripts/commission/throw_undetected_condition.gd" id="3_throw"]
[ext_resource type="Resource" path="res://data/opponents/opponent_01.tres" id="4_opponent"]
[ext_resource type="Resource" path="res://data/stages/court.tres" id="5_stage"]
[ext_resource type="Texture2D" path="res://assets/art/clients/ines.png" id="6_portrait"]

[sub_resource type="Resource" id="condition_throw"]
script = ExtResource("3_throw")

[resource]
script = ExtResource("1_commission")
client_name = "바르톨로의 누이 이네스"
dialogue = "오라버니는 한 번만 이기면 체면이 서서 이 무모한 결투질을 그만둘 거예요. 져 주세요. 다만 봐줬다는 걸 알면 더 날뛸 테니, 제대로 싸우다 진 것처럼 보여야 해요. 금방 쓰러지거나 가만히 서서 맞으면 눈치챌 거예요.
오라버니는 찌르기는 금방 거둬들이지만 베고 나면 한참 허우적대요. 공격이 자꾸 막히면 성질을 못 이기고 크게 휘두르고요. 몇 번은 막고 받아쳐 주세요. 그렇다고 이겨 버리시면 안 돼요."
opponent = ExtResource("4_opponent")
stage = ExtResource("5_stage")
client_portrait = ExtResource("6_portrait")
conditions = Array[ExtResource("2_condition")]([SubResource("condition_throw")])
base_reward = 40
tip_max = 30
reputation_effect = {"accept": 0, "success": 3, "fail": -1}
haggle_min_stars = 4
success_line = "오라버니가 온 동네에 자랑하고 다녀요. 제 힘으로 이긴 줄 알아요. 아프셨을 텐데, 고맙습니다."
decline_line = "…그렇지요. 져 달라는 부탁이 쉬울 리 없지요. 폐를 끼쳤어요."
fail_line = "오라버니는 내일도 칼을 차고 나가겠지요. 부탁드린 건 이게 아니에요. 보수는 못 드려요."
partial_line = "지기는 지셨는데 오라버니가 고개를 갸웃해요. 봐준 게 아니냐고요. 보수는 다 드릴 수가 없어요."
haggle_agree_line = "알겠어요, 그 값에 해요. 대신 오라버니가 조금도 눈치채면 안 돼요."
haggle_refuse_line = "죄송해요, 그 값은 어렵겠어요. 처음 값으로 해요. 덤도 줄여야겠어요."
