[gd_resource type="Resource" script_class="Commission" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/commission/commission.gd" id="1_commission"]
[ext_resource type="Script" path="res://scripts/commission/commission_condition.gd" id="2_condition"]
[ext_resource type="Script" path="res://scripts/commission/throw_undetected_condition.gd" id="3_throw"]
[ext_resource type="Resource" path="res://data/opponents/opponent_01.tres" id="4_opponent"]

[sub_resource type="Resource" id="condition_throw"]
script = ExtResource("3_throw")

[resource]
script = ExtResource("1_commission")
client_name = "노름꾼 가스파로"
dialogue = "긴말 안 하겠소. 이 결투에 바르톨로 쪽으로 크게 걸었소. 당신이 져 주면 되는 일이오. 짜고 친 티가 나면 판돈이 통째로 날아가니, 금방 쓰러지거나 가만히 서서 맞지는 마시오.
그자는 베고 나면 허우적대니 받아칠 틈은 있을 거요. 몇 번은 막고 받아쳐 주시오. 다만 이겨 버리면 우리 둘 다 끝이오."
opponent = ExtResource("4_opponent")
conditions = Array[ExtResource("2_condition")]([SubResource("condition_throw")])
base_reward = 65
tip_max = 35
reputation_effect = {"accept": -6, "success": 0, "fail": -2}
haggle_min_stars = 2
success_line = "하! 판돈은 무사하오. 맞는 연기가 제법이더군. 약속한 몫이오. 다음 판에도 부탁하리다."
decline_line = "허, 깨끗한 척하시긴. 칼잡이가 여기뿐인 줄 아시오?"
fail_line = "판돈이 통째로 날아갔소. 당신 몫? 남은 게 있어야 주지. 오늘은 재수가 옴 붙었군."
partial_line = "지긴 졌는데 연기가 서툴렀소. 판이 수상하다고 내 몫을 떼였소. 당신 몫도 그만큼 깎이오."
haggle_agree_line = "배짱 한번 좋군. 좋소, 그 값에 하지. 대신 티가 털끝만큼도 나면 안 되오."
haggle_refuse_line = "허, 욕심이 과하시군. 처음 값이오. 덤은 줄어들 줄 아시오."
