[gd_resource type="Resource" script_class="Commission" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/commission/commission.gd" id="1_commission"]
[ext_resource type="Script" path="res://scripts/commission/commission_condition.gd" id="2_condition"]
[ext_resource type="Script" path="res://scripts/commission/first_blood_condition.gd" id="3_first_blood"]
[ext_resource type="Resource" path="res://data/opponents/opponent_03.tres" id="4_opponent"]
[ext_resource type="Resource" path="res://data/stages/piazza.tres" id="5_stage"]
[ext_resource type="Texture2D" path="res://assets/art/clients/vittorio.png" id="6_portrait"]

[sub_resource type="Resource" id="condition_first_blood"]
script = ExtResource("3_first_blood")

[resource]
script = ExtResource("1_commission")
client_name = "대금업자 비토리오"
dialogue = "로렌초가 사람들 앞에서 나를 사기꾼이라 했소. 뭐, 이자를 좀 세게 받긴 했지. 그래도 값은 치르게 해야겠소. 피 한 방울이면 되오. 얼굴은 두시오. 돈은 넉넉히 드리리다.
듣자니 그 멋쟁이는 한 걸음 물러섰다가 단번에 뛰어들어 찌르고, 공격이 자꾸 막히면 크게 휘두른다더군."
opponent = ExtResource("4_opponent")
stage = ExtResource("5_stage")
client_portrait = ExtResource("6_portrait")
conditions = Array[ExtResource("2_condition")]([SubResource("condition_first_blood")])
base_reward = 55
tip_max = 20
reputation_effect = {"accept": -4, "success": 0, "fail": -1, "win": 1}
haggle_min_stars = 5
success_line = "좋소. 그자도 이제 입조심을 하겠지. 약속대로 넉넉히 넣었소. 돈이 급하면 언제든 오시오."
decline_line = "내 돈이 싫다? 별일이군. 후회나 마시오."
fail_line = "피 한 방울 못 봤다? 돈값을 못 하는 칼이군. 한 푼도 없소. 이 일은 없던 것으로 하지."
partial_line = "얼굴은 두라 했을 텐데. 눈에 띄는 상처는 내게도 손해요. 그만큼 제하고 치르겠소."
haggle_agree_line = "값을 더 부른다? 좋소, 치르지. 대신 흠이 하나라도 있으면 그만큼 제하겠소."
haggle_refuse_line = "내게서 돈을 더 뜯겠다? 처음 값이오. 얹어 주려던 것도 줄이겠소."
