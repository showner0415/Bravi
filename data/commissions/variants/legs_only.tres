[gd_resource type="Resource" script_class="Commission" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/commission/commission.gd" id="1_commission"]
[ext_resource type="Script" path="res://scripts/commission/commission_condition.gd" id="2_condition"]
[ext_resource type="Script" path="res://scripts/commission/target_part_condition.gd" id="3_target_part"]
[ext_resource type="Resource" path="res://data/opponents/opponent_01.tres" id="4_opponent"]
[ext_resource type="Resource" path="res://data/stages/court.tres" id="5_stage"]

[sub_resource type="Resource" id="condition_legs"]
script = ExtResource("3_target_part")
target_part = 5

[resource]
script = ExtResource("1_commission")
client_name = "무용 교사 오르솔라"
dialogue = "바르톨로가 제 무도회에서 제자의 발을 일부러 밟고는 춤도 못 추는 것들이라며 웃었어요. 그 잘난 다리에 한 줄만 그어 주세요. 다른 곳은 건드리지 마시고요.
칼끝을 낮게 두셔야 할 거예요."
opponent = ExtResource("4_opponent")
stage = ExtResource("5_stage")
conditions = Array[ExtResource("2_condition")]([SubResource("condition_legs")])
base_reward = 35
tip_max = 20
reputation_effect = {"accept": 0, "success": 3, "fail": -1, "win": 1}
haggle_min_stars = 3
success_line = "절뚝거리며 나가는 걸 제자들과 창가에서 봤어요. 속이 다 시원하네요."
decline_line = "그래요… 춤으로 갚아 줄 수도 없는 노릇이고. 알겠어요."
fail_line = "다리에 한 줄, 그것만 부탁드렸는데요. 박자를 통째로 놓치셨네요. 보수는 드릴 수 없어요."
partial_line = "다리에 긋기는 하셨는데 다른 데까지 건드리셨네요. 군더더기가 많았어요. 보수는 깎을게요."
haggle_agree_line = "좋아요, 그 값에 하죠. 대신 다리에만, 한 줄만이에요. 군더더기 없이요."
haggle_refuse_line = "무도회를 한 번 열 값이네요. 처음 값으로 하죠. 덤은 줄일게요."
