[gd_resource type="Resource" script_class="Commission" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/commission/commission.gd" id="1_commission"]
[ext_resource type="Script" path="res://scripts/commission/commission_condition.gd" id="2_condition"]
[ext_resource type="Script" path="res://scripts/commission/target_part_condition.gd" id="3_target_part"]
[ext_resource type="Resource" path="res://data/opponents/opponent_01.tres" id="4_opponent"]
[ext_resource type="Resource" path="res://data/stages/alley.tres" id="5_stage"]
[ext_resource type="Texture2D" path="res://assets/art/clients/clara.png" id="6_portrait"]

[sub_resource type="Resource" id="condition_feather"]
script = ExtResource("3_target_part")
target_part = 1
graze_penalty = 0

[resource]
script = ExtResource("1_commission")
client_name = "모자 장인 클라라"
dialogue = "바르톨로가 쓰고 다니는 그 모자, 값도 안 치르고 가져간 제 물건이에요. 깃털만 잘라 주세요. 칼을 섞는 거야 어쩔 수 없지만, 그 사람 몸에 상처는 내지 말고요. 다치면 제가 곤란해져요.
칼을 쳐내거나 아주 무너뜨린 뒤에야 모자에 손이 닿을 거예요. 그 사람은 찌르기는 금방 거둬들이지만 베고 나면 한참 허우적대요. 공격이 자꾸 막히면 성질을 못 이기고 크게 휘두른다니, 그때를 노려도 좋고요."
opponent = ExtResource("4_opponent")
opponent_wears_hat = true
stage = ExtResource("5_stage")
client_portrait = ExtResource("6_portrait")
conditions = Array[ExtResource("2_condition")]([SubResource("condition_feather")])
base_reward = 45
tip_max = 25
reputation_effect = {"accept": 0, "success": 3, "fail": -1, "win": 1}
haggle_min_stars = 4
success_line = "깃털이 잘려 나갔다면서요! 그 사람 얼굴이 볼만했겠어요. 고마워요."
decline_line = "어머, 그런가요. 모자값은 영영 못 받겠네요…"
fail_line = "깃털 하나만 부탁드렸는데… 이제 모자값 얘기는 꺼내지도 못하겠어요. 보수는 못 드려요."
partial_line = "깃털은 잘렸지만 그 사람을 다치게 하셨잖아요. 제가 곤란해진다고 했는데… 보수는 깎을게요."
haggle_agree_line = "좋아요, 그 값에 해요. 대신 깃털만이에요. 몸에는 상처 하나 없어야 해요."
haggle_refuse_line = "모자값도 못 받은 사람한테 너무하세요. 처음 값으로 해요. 덤은 줄일게요."
